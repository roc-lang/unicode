InternalGraphemeData :: [].{
    GCB : [Other, CR, LF, Control, Extend, ZWJ, RI, Prepend, SpacingMark, L, V, T, LV, LVT]
    InCB : [None, Consonant, Extend, Linker]
    Props : { gcb : GCB, incb : InCB, extended_pictographic : Bool }

    lookup : U32 -> Props
    lookup = |scalar| {
        page_id = page_index.get(scalar.shr_wrap(8).to_u64()) ?? 0
        offset = page_id.to_u64() * 256 + scalar.bitwise_and(255).to_u64()
        value = pages.get(offset) ?? 0

        {
            gcb: gcb_from_u8(value.bitwise_and(0x0F)),
            incb: incb_from_u8(value.shr_wrap(4).bitwise_and(0x03)),
            extended_pictographic: value.bitwise_and(0x40) != 0,
        }
    }
}

gcb_from_u8 : U8 -> InternalGraphemeData.GCB
gcb_from_u8 = |value| {
    match value {
        0 => Other
        1 => CR
        2 => LF
        3 => Control
        4 => Extend
        5 => ZWJ
        6 => RI
        7 => Prepend
        8 => SpacingMark
        9 => L
        10 => V
        11 => T
        12 => LV
        13 => LVT
        _ => ...
    }
}

incb_from_u8 : U8 -> InternalGraphemeData.InCB
incb_from_u8 = |value| {
    match value {
        0 => None
        1 => Consonant
        2 => Extend
        3 => Linker
        _ => ...
    }
}

