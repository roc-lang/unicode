    }
}

ascii_value : U32 -> U8
ascii_value = |u32| if u32 == 13 (1) else if u32 == 10 (2) else if (u32 >= 11 and u32 <= 12) (3) else if (u32 >= 65 and u32 <= 90) or (u32 >= 97 and u32 <= 122) (8) else if u32 == 39 (9) else if u32 == 34 (10) else if u32 == 46 (11) else if u32 == 58 (12) else if u32 == 44 or u32 == 59 (13) else if (u32 >= 48 and u32 <= 57) (14) else if u32 == 95 (15) else if u32 == 32 (17) else 0

word_break_from_u8 : U8 -> InternalWordData.WordBreak
word_break_from_u8 = |value| {
