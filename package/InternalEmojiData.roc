            emoji: value.bitwise_and(0x01) != 0,
            emoji_presentation: value.bitwise_and(0x02) != 0,
            emoji_modifier: value.bitwise_and(0x04) != 0,
            emoji_modifier_base: value.bitwise_and(0x08) != 0,
            emoji_component: value.bitwise_and(0x10) != 0,
            extended_pictographic: value.bitwise_and(0x20) != 0,
        }
    }
