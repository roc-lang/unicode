## GENERATED from Unicode 17.0.0 case mappings and contextual case properties. Run `python3 scripts/unicode_data.py generate`. ##
## Simple-map zero is a private identity sentinel; table row IDs and mapping offsets are private. ##
## layout: 8704 U8 page ids + 170 x 128 U16 values; logical page payload 52224 bytes; logical non-page payload 72774 bytes; 3100 rows, 119 special entries, 1618 folding entries. ##

InternalCaseData :: [].{
    Language : [Azeri, Lithuanian, Turkish]
    Context : [Final_Sigma, After_Soft_Dotted, More_Above, Before_Dot, After_I, Not_Before_Dot]
    FoldStatus : [Common, Full, Simple, Turkic]
    Special : { lower : List(U32), title : List(U32), upper : List(U32), languages : List(Language), contexts : List(Context) }
    Fold : { status : FoldStatus, mapping : List(U32) }
    Props : { simple_upper : U32, simple_lower : U32, simple_title : U32, ccc : U8, cased : Bool, case_ignorable : Bool, soft_dotted : Bool, special_start : U16, special_count : U8, fold_start : U16, fold_count : U8 }

    lookup : U32 -> Props
    lookup = |scalar| {
        row_id = if scalar > 0x10FFFF { 0 } else {
            page_id = page_index.get(scalar.shr_wrap(7).to_u64()) ?? 0
            pages.get(page_id.to_u64() * 128 + scalar.bitwise_and(127).to_u64()) ?? 0
        }
        row = rows.get(row_id.to_u64()) ?? (rows.get(0) ?? ...)
        {
            simple_upper: row.simple_upper, simple_lower: row.simple_lower, simple_title: row.simple_title, ccc: row.ccc,
            cased: row.flags.bitwise_and(1.U8) != 0.U8, case_ignorable: row.flags.bitwise_and(2.U8) != 0.U8, soft_dotted: row.flags.bitwise_and(4.U8) != 0.U8,
            special_start: row.special_start, special_count: row.special_count, fold_start: row.fold_start, fold_count: row.fold_count,
        }
    }

    special_entries : List(Special)
    special_entries = specials

    fold_entries : List(Fold)
    fold_entries = folds
}

Row : { simple_upper : U32, simple_lower : U32, simple_title : U32, ccc : U8, flags : U8, special_start : U16, special_count : U8, fold_start : U16, fold_count : U8 }

